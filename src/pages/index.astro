      <figure class="relative h-[520px] md:h-[650px]"><img src="/images/tumpak-sewu-jungle.webp" alt="Tumpak Sewu di tengah hutan hijau dan kabut lembah" class="absolute inset-0 h-full w-full object-cover" width="1800" height="1200" loading="lazy" /><div class="absolute inset-0 bg-gradient-to-t from-[#071a16]/70 to-transparent"></div><figcaption class="absolute bottom-6 left-6 rounded-full bg-black/45 px-3 py-1.5 text-[.65rem] text-white/80 backdrop-blur">Foto Tumpak Sewu · <a href="https://www.pexels.com/photo/tumpak-sewu-waterfall-in-lush-java-jungle-32402818/">Joni Agung / Pexels</a></figcaption></figure>
    </section>

