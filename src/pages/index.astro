---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';

const siteUrl = Astro.site?.href?.replace(/\/$/, '');
const placeId = '0x2dd614085869da41:0x4a94cc5f06772982';
const mapLink = 'https://maps.app.goo.gl/Jf85DUy2gXzMmAaU7';
const mapEmbed = 'https://maps.google.com/maps?q=-8.2314861,112.9176193&z=16&output=embed';

const attractionSchema = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  '@id': siteUrl ? `${siteUrl}/#tumpak-sewu` : `urn:google-place:${placeId}`,
  name: 'Air Terjun Tumpak Sewu',
  alternateName: ['Tumpak Sewu Waterfall', 'Coban Sewu'],
  description: 'Panduan independen untuk Air Terjun Tumpak Sewu di Desa Sidomulyo, Kecamatan Pronojiwo, Kabupaten Lumajang, Jawa Timur.',
  ...(siteUrl ? { url: `${siteUrl}/`, image: `${siteUrl}/images/tumpak-sewu-aerial.webp` } : {}),
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Jl. Raya Dampit-Lumajang, Besukcukit, Sidomulyo',
    addressLocality: 'Pronojiwo',
    addressRegion: 'Jawa Timur',
    postalCode: '67374',
    addressCountry: 'ID'
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: -8.2314861,
    longitude: 112.9176193
  },
  hasMap: mapLink
};

const faqItems = [
  {
    "q": "Apa perbedaan panorama atas dan jalur lembah?",
    "a": "Area panorama atas dan jalur menuju dasar lembah adalah pilihan akses yang berbeda. Izin atau tiket untuk satu area tidak otomatis berlaku untuk yang lain. Tanyakan bagian yang sedang dibuka dan kondisi pijakan kepada petugas; panduan ini tidak menjamin jalur lembah dapat dimasuki."
  },
  {
    "q": "Kapan jam buka Tumpak Sewu?",
    "a": "Maps yang diperiksa 19 Oktober 2026 mencantumkan 07.00–15.00 setiap hari (WIB). Ini catatan pihak ketiga bertanggal, bukan jaminan operasi hari libur, waktu masuk terakhir, atau akses semua area. Konfirmasikan ke lokasi sebelum berangkat."
  },
  {
    "q": "Berapa harga tiket masuk sekarang?",
    "a": "Tarif berlaku saat ini belum terverifikasi. Berita Pemkab Lumajang 2 Februari 2026 membahas pungutan tetapi tidak menyebut angka tarif yang bisa dipakai sebagai harga terkini. Tanyakan kategori pengunjung, area yang tercakup, biaya parkir dan layanan pemandu di loket sebelum membayar."
  },
  {
    "q": "Apakah satu tiket mencakup semua pintu dan area?",
    "a": "Jangan menganggap demikian. Kesepakatan pemerintah 24 Desember 2024 merupakan catatan historis dan masih membahas koordinasi pungutan di kawasan lembah sisi Malang. Itu bukan jaminan bahwa semua area atau pintu masuk telah memakai satu tarif pada 2026."
  },
  {
    "q": "Apakah pemandu wajib dan berapa biayanya?",
    "a": "Kewajiban, layanan dan biaya pemandu untuk rute tertentu belum diverifikasi. Tanyakan kepada petugas untuk area yang benar-benar akan dikunjungi, beserta biaya dan cakupannya. Kehadiran pemandu tidak menggantikan penutupan atau batas akses."
  },
  {
    "q": "Bagaimana merencanakan kunjungan saat cuaca berubah?",
    "a": "Periksa prakiraan cuaca dan pengumuman di lokasi. Hujan, aliran air dan pijakan basah dapat memengaruhi rute; ikuti pembatasan petugas dan jangan memaksakan turun. Jam yang tercantum di Maps tidak berarti jalur lembah atau sungai selalu boleh dimasuki."
  },
  {
    "q": "Apakah boleh berenang atau menyusuri sungai?",
    "a": "Panduan ini tidak mengonfirmasi izin atau keamanan berenang dan susur sungai. Jangan menganggap aliran air sebagai area berenang; ikuti batas dan arahan petugas di lokasi."
  },
  {
    "q": "Apakah tersedia toilet, parkir dan akses tanpa tangga?",
    "a": "Lokasi, ketersediaan, biaya dan kondisi fasilitas pada hari kunjungan belum diverifikasi. Tanyakan kepada petugas atau operator terkait sebelum mengandalkannya, termasuk kondisi tangga dan kebutuhan mobilitas."
  },
  {
    "q": "Berapa lama sebaiknya menyiapkan waktu?",
    "a": "Tidak ada durasi tetap yang dijamin di panduan ini. Sesuaikan dengan area yang diizinkan, cuaca, mobilitas, perjalanan kembali dan waktu tutup yang telah dikonfirmasi. Rencana turun ke lembah harus dikonfirmasi terpisah dari kunjungan panorama."
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a }
  }))
};
---
<BaseLayout
  title="Tumpak Sewu Lumajang: Lokasi, Rute & Akses Kunjungan"
  description="Panduan independen Tumpak Sewu di Sidomulyo, Lumajang: lokasi, beda panorama dan jalur lembah, cuaca, jam Maps bertanggal, serta konfirmasi tiket dan akses."
  schema={[attractionSchema, faqSchema]}
>
  <Header />
  <main>
    <section class="hero-mask relative min-h-[850px] overflow-hidden bg-[#071a16] text-white md:min-h-[900px]">
      <img src="/images/tumpak-sewu-aerial.webp" alt="Tirai Air Terjun Tumpak Sewu dilihat dari udara di antara tebing hijau" class="absolute inset-0 h-full w-full object-cover" width="1800" height="1350" fetchpriority="high" />
      <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(7,26,22,.92)_0%,rgba(7,26,22,.54)_48%,rgba(7,26,22,.12)_75%),linear-gradient(0deg,rgba(7,26,22,.78)_0%,transparent_55%)]"></div>
      <div class="absolute inset-0 terrain-grid opacity-30"></div>
      <div class="section-shell relative z-10 flex min-h-[850px] items-end pb-28 pt-32 md:min-h-[900px] md:pb-36">
        <div class="max-w-5xl">
          <div class="mb-8 flex items-center gap-3 text-[#bde1dc]">
            <span class="h-px w-12 bg-[#bde1dc]"></span>
            <p class="eyebrow">Sidomulyo · Pronojiwo · Lumajang</p>
          </div>
          <h1 class="display text-[clamp(4.4rem,13vw,10.5rem)] leading-[.7] tracking-[-.065em]">Tumpak<br /><span class="ml-[.16em] text-[#bde1dc]">Sewu</span></h1>
          <div class="mt-10 grid max-w-3xl gap-5 border-t border-white/30 pt-6 sm:grid-cols-[1.3fr_.7fr]">
            <p class="max-w-xl text-lg leading-8 text-white/82">Panduan independen untuk Air Terjun Tumpak Sewu di Sidomulyo, Pronojiwo, Lumajang. Bedakan kunjungan panorama atas dari jalur lembah; konfirmasikan cuaca, area yang diizinkan dan ketentuan sebelum berangkat.</p>
            <div class="sm:text-right">
              <p class="display text-3xl text-[#bde1dc]">Panorama / lembah</p>
              <p class="mt-1 text-xs font-bold uppercase tracking-[.18em] text-white/55">dua cakupan akses berbeda</p>
            </div>
          </div>
        </div>
      </div>
      <a href="https://www.pexels.com/id-id/foto/pemandangan-lanskap-lansekap-hutan-10562473/" target="_blank" rel="noopener noreferrer" class="absolute bottom-12 left-6 z-20 text-xs text-white/80">Foto: Jagad Lanang / Pexels</a>
      <div class="absolute bottom-24 right-0 hidden rotate-90 origin-bottom-right items-center gap-4 text-[.62rem] font-extrabold uppercase tracking-[.3em] text-white/60 xl:flex">
        <span>8,2315° LS</span><span class="h-px w-16 bg-white/40"></span><span>112,9176° BT</span>
      </div>
    </section>

    <section id="rencanakan" class="relative z-10 -mt-10 pb-24 md:-mt-20 md:pb-32">
      <div class="section-shell">
        <div class="grid overflow-hidden rounded-[2rem] bg-[#f2f5ee] shadow-[0_24px_80px_rgba(7,26,22,.2)] md:grid-cols-2 xl:grid-cols-4">
          <div class="border-b border-black/10 p-6 md:border-r xl:border-b-0">
            <p class="eyebrow text-[#1d5744]">Jam kunjungan</p>
            <p class="display mt-4 text-4xl text-[#0b2820]">07.00–15.00</p>
            <p class="mt-3 text-sm leading-6 text-black/55">Catatan Google Maps diperiksa 19 Oktober 2026, tujuh hari 07.00–15.00 (WIB). Konfirmasikan jam dan area yang dibuka; ini bukan jaminan semua rute dapat diakses.</p>
          </div>
          <div class="border-b border-black/10 p-6 xl:border-b-0 xl:border-r">
            <p class="eyebrow text-[#1d5744]">Tiket & cakupan</p>
            <p class="display mt-4 text-4xl text-[#0b2820]">Konfirmasi di loket</p>
            <p class="mt-3 text-sm leading-6 text-black/55">Tarif terkini belum terverifikasi. Pastikan kategori pengunjung, area yang tercakup, parkir dan layanan pemandu sebelum membayar.</p>
          </div>
          <div class="border-b border-black/10 p-6 md:border-r md:border-b-0">
            <p class="eyebrow text-[#1d5744]">Waktu terbaik</p>
            <p class="display mt-4 text-4xl text-[#0b2820]">Pagi</p>
            <p class="mt-3 text-sm leading-6 text-black/55">Mulai lebih awal agar punya waktu membaca cuaca dan kondisi jalur. Hindari turun ke lembah saat hujan deras.</p>
          </div>
          <div class="p-6">
            <p class="eyebrow text-[#1d5744]">Waktu kunjungan</p>
            <p class="display mt-4 text-4xl text-[#0b2820]">Sesuai kondisi</p>
            <p class="mt-3 text-sm leading-6 text-black/55">Sesuaikan waktu dengan area yang diizinkan, cuaca, mobilitas dan perjalanan kembali; jangan menganggap jalur lembah terbuka.</p>
          </div>
        </div>
        <p class="mt-5 text-xs leading-5 text-black/50">Maps diperiksa 19 Oktober 2026: 4,8/5 dari 9.921 ulasan. Penilaian pihak ketiga ini bukan penilaian dari panduan kami. Tarif, jam dan akses dapat berubah; konfirmasikan kondisi hari kunjungan.</p>
      </div>
    </section>

    <section id="kisah" class="overflow-hidden bg-[#0b2820] text-white"><div class="section-shell grid gap-12 py-24 lg:grid-cols-2"><div><p class="eyebrow text-[#bde1dc]">Sidomulyo · Pronojiwo</p><h2 class="display mt-5 text-5xl md:text-7xl">Lanskap yang perlu dibaca per area.</h2></div><div class="space-y-6 text-sm leading-8 text-white/70"><p>Lokasi pada panduan ini adalah Tumpak Sewu di Desa Sidomulyo, Kecamatan Pronojiwo, Kabupaten Lumajang. Gunakan alamat dan pin yang sesuai dengan titik tujuan Anda; nama destinasi saja tidak menjelaskan seluruh pintu atau cakupan tiket.</p><p>Panorama atas, jalur turun, dasar lembah dan aliran sungai tidak boleh diperlakukan sebagai satu area dengan izin otomatis yang sama. Ikuti penanda dan arahan petugas, termasuk ketika hanya sebagian kawasan dapat dikunjungi.</p><p>Foto membantu mengenali lanskap, tetapi tidak menunjukkan bahwa jalur tertentu sedang terbuka. Periksa informasi cuaca dan kondisi saat akan berangkat.</p></div></div><figure class="relative h-[440px] md:h-[560px]"><img src="/images/tumpak-sewu-panorama.webp" alt="Panorama Tumpak Sewu di antara tebing hijau" class="h-full w-full object-cover" width="1800" height="1200" loading="lazy"/><figcaption class="absolute bottom-4 left-4 rounded-full bg-black/60 px-3 py-2 text-xs text-white">Foto: <a href="https://www.pexels.com/photo/high-angle-shot-of-a-rainforest-waterfall-7064356/">Timur Kozmenko / Pexels</a> · bukan konfirmasi akses hari ini</figcaption></figure></section>

    <section id="rute" class="bg-[#f6f4ed] py-24 md:py-32">
      <div class="section-shell">
        <div class="grid gap-12 lg:grid-cols-[.8fr_1.2fr]">
          <div>
            <p class="eyebrow text-[#1d5744]">Pilih pengalaman</p>
            <h2 class="display mt-5 text-5xl leading-[.95] text-[#0b2820] md:text-7xl">Dua cara membaca Tumpak Sewu.</h2>
            <p class="mt-6 max-w-lg text-base leading-8 text-black/60">Tentukan area yang ingin dilihat, kemudian tanyakan apakah area dan jalur tersebut boleh dimasuki pada hari kunjungan. Rencana panorama tidak otomatis mencakup lembah.</p>
          </div>
          <div class="grid gap-5 md:grid-cols-2">
            <article class="rounded-[2rem] border border-black/10 bg-white p-7">
              <div class="flex items-center justify-between"><span class="eyebrow text-[#688b58]">Rute A</span><span class="rounded-full bg-[#e8efe5] px-3 py-1 text-xs font-bold text-[#1d5744]">Periksa akses</span></div>
              <h3 class="display mt-8 text-4xl text-[#0b2820]">Panorama atas</h3>
              <p class="mt-4 text-sm leading-7 text-black/60">Konfirmasikan titik masuk, kondisi jalan kaki, tangga dan pembatas menuju area panorama. Jangan menganggap semua titik pandang terbuka atau bebas hambatan untuk setiap kebutuhan mobilitas.</p>
              <ul class="mt-6 space-y-3 text-sm text-black/70">
                <li class="flex gap-3"><span class="text-[#bd6843]">●</span><span>Fokus pada komposisi tirai air dan lembah.</span></li>
                <li class="flex gap-3"><span class="text-[#bd6843]">●</span><span>Sesuaikan durasi dengan akses yang benar-benar diizinkan.</span></li>
                <li class="flex gap-3"><span class="text-[#bd6843]">●</span><span>Tetap waspadai permukaan basah dan pembatas.</span></li>
              </ul>
            </article>
            <article class="rounded-[2rem] bg-[#0b2820] p-7 text-white">
              <div class="flex items-center justify-between"><span class="eyebrow text-[#bde1dc]">Rute B</span><span class="rounded-full bg-[#bd6843] px-3 py-1 text-xs font-bold text-white">Menuntut fisik</span></div>
              <h3 class="display mt-8 text-4xl">Turun ke lembah</h3>
              <p class="mt-4 text-sm leading-7 text-white/65">Rute lembah perlu konfirmasi terpisah mengenai status buka, cuaca, pijakan dan perjalanan kembali. Jangan turun berdasarkan foto atau jam Maps saja; pembatasan petugas berlaku meski area panorama dibuka.</p>
              <ul class="mt-6 space-y-3 text-sm text-white/75">
                <li class="flex gap-3"><span class="text-[#bde1dc]">●</span><span>Curam, basah, licin, dan dapat bersinggungan dengan aliran air.</span></li>
                <li class="flex gap-3"><span class="text-[#bde1dc]">●</span><span>Jangan menganggap akses lembah mencakup izin memasuki sungai.</span></li>
                <li class="flex gap-3"><span class="text-[#bde1dc]">●</span><span>Jangan turun bila petugas membatasi akses.</span></li>
              </ul>
            </article>
          </div>
        </div>
        <div class="mt-12 grid overflow-hidden rounded-[2rem] bg-[#dfe8db] lg:grid-cols-[.9fr_1.1fr]">
          <figure class="relative min-h-[460px]">
            <img src="/images/tumpak-sewu-visitor.webp" alt="Pengunjung memandang Air Terjun Tumpak Sewu dari area hijau" class="absolute inset-0 h-full w-full object-cover" width="1800" height="2400" loading="lazy" />
            <figcaption class="absolute bottom-4 left-4 rounded-full bg-black/45 px-3 py-1.5 text-[.65rem] text-white/80 backdrop-blur">Foto Tumpak Sewu · <a href="https://www.pexels.com/photo/man-facing-waterfalls-2865715/">Iqbal Kurniawan / Pexels</a></figcaption>
          </figure>
          <div class="p-8 md:p-12">
            <p class="eyebrow text-[#1d5744]">Keselamatan sebelum estetika</p>
            <h3 class="display mt-4 text-4xl text-[#0b2820] md:text-5xl">Buat keputusan di lokasi, bukan dari foto.</h3>
            <div class="mt-8 grid gap-5 sm:grid-cols-2">
              <div class="detail-card pt-4"><strong class="text-sm">Cuaca</strong><p class="mt-2 text-sm leading-6 text-black/60">Hujan dapat mengubah debit dan kondisi pijakan dengan cepat.</p></div>
              <div class="detail-card pt-4"><strong class="text-sm">Alas kaki</strong><p class="mt-2 text-sm leading-6 text-black/60">Utamakan tapak yang menggigit permukaan basah, bukan alas kaki licin.</p></div>
              <div class="detail-card pt-4"><strong class="text-sm">Perlengkapan</strong><p class="mt-2 text-sm leading-6 text-black/60">Bawa air minum, pelindung perangkat, dan tas yang menyisakan kedua tangan bebas.</p></div>
              <div class="detail-card pt-4"><strong class="text-sm">Kemampuan</strong><p class="mt-2 text-sm leading-6 text-black/60">Berbalik adalah pilihan yang wajar bila fisik atau kondisi jalur tidak mendukung.</p></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="biaya" class="bg-[#d9d5c9] py-24"><div class="section-shell grid gap-10 lg:grid-cols-2"><div><p class="eyebrow text-[#1d5744]">Biaya & cakupan</p><h2 class="display mt-5 text-5xl text-[#0b2820]">Tanyakan apa yang termasuk sebelum membayar.</h2></div><div class="space-y-6 text-sm leading-8 text-black/65"><p>Berita Pemkab Lumajang <a href="https://lumajangkab.go.id/berita-opd/detail/6795" class="underline">2 Februari 2026</a> membahas pungutan di Tumpak Sewu tanpa memberikan angka yang dapat dipakai sebagai tarif terkini. Panduan ini tidak menetapkan harga masuk, biaya pemandu atau tarif parkir.</p><p><a href="https://lumajangkab.go.id/berita-opd/detail/4222" class="underline">Kesepakatan 24 Desember 2024</a> adalah catatan historis dan masih memuat koordinasi pungutan kawasan lembah sisi Malang. Jangan menafsirkannya sebagai jaminan bahwa seluruh pintu dan area telah memakai satu tarif pada 2026.</p><ul class="list-disc space-y-3 pl-5"><li>Konfirmasikan kategori pengunjung dan area yang termasuk dalam tiket.</li><li>Tanyakan biaya parkir serta layanan pemandu, apakah diwajibkan untuk rute yang dipilih, dan apa cakupannya.</li><li>Simpan informasi transaksi; tiket atau pemandu tidak menggantikan penutupan maupun batas akses petugas.</li></ul></div></div></section>

    <section id="transportasi" class="bg-[#f6f4ed] py-24 md:py-32">
      <div class="section-shell">
        <div class="max-w-4xl"><p class="eyebrow text-[#1d5744]">Transportasi terperinci</p><h2 class="display mt-5 text-5xl leading-[.95] text-[#0b2820] md:text-7xl">Tujuan akhirnya: Pronojiwo.</h2><p class="mt-6 text-base leading-8 text-black/60">Tujuan pada peta adalah Sidomulyo, Pronojiwo, di koridor Dampit–Lumajang. Konfirmasikan rute, titik turun, sambungan terakhir dan perjalanan pulang kepada operator; jangan menganggap ada layanan langsung pada tanggal perjalanan Anda.</p></div>
        <div class="mt-12 grid gap-x-8 lg:grid-cols-2">
          <article class="detail-card py-7"><div class="flex gap-5"><span class="display text-4xl text-[#bd6843]">01</span><div><h3 class="text-xl font-extrabold">Dari bandara</h3><p class="mt-3 text-sm leading-7 text-black/60">Jika datang melalui bandara, periksa penerbangan dan sambungan darat yang benar-benar tersedia pada tanggal perjalanan. Sepakati tujuan Sidomulyo, titik turun, ongkos dan perjalanan pulang; tidak ada jadwal atau layanan langsung yang dijamin di sini.</p></div></div></article>
          <article class="detail-card py-7"><div class="flex gap-5"><span class="display text-4xl text-[#bd6843]">02</span><div><h3 class="text-xl font-extrabold">Bus & angkutan umum</h3><p class="mt-3 text-sm leading-7 text-black/60">Tanyakan kepada operator mengenai rute yang beroperasi menuju Pronojiwo, terminal tujuan, jadwal terakhir dan sambungan ke titik masuk yang dipilih. Konfirmasikan juga perjalanan kembali; tarif dan frekuensi belum diverifikasi panduan ini.</p></div></div></article>
          <article class="detail-card py-7"><div class="flex gap-5"><span class="display text-4xl text-[#bd6843]">03</span><div><h3 class="text-xl font-extrabold">Taksi, kendaraan dengan pengemudi</h3><p class="mt-3 text-sm leading-7 text-black/60">Jika memilih kendaraan dengan pengemudi, pastikan tujuan, tarif, titik tunggu, durasi sewa dan biaya parkir disepakati sebelum berangkat. Situs ini tidak menunjuk operator tertentu dan tidak menerima komisi perjalanan.</p></div></div></article>
          <article class="detail-card py-7"><div class="flex gap-5"><span class="display text-4xl text-[#bd6843]">04</span><div><h3 class="text-xl font-extrabold">Kendaraan pribadi</h3><p class="mt-3 text-sm leading-7 text-black/60">Masukkan alamat Sidomulyo, Pronojiwo dan pin tujuan yang sesuai. Konfirmasikan kondisi jalan, titik parkir dan area turun penumpang; ikuti rambu dan jangan menutup akses jalan atau layanan darurat.</p></div></div></article>
        </div>
        <div class="mt-8 rounded-[2rem] bg-[#bd6843] p-7 text-[#071a16] md:p-9"><p class="eyebrow">Prinsip penting</p><p class="display mt-3 text-3xl md:text-4xl">Jangan menyusun koneksi transportasi terlalu ketat.</p><p class="mt-3 max-w-4xl text-sm font-medium leading-7">Jalan pegunungan, cuaca, pekerjaan jalan, dan frekuensi angkutan lokal dapat mengubah waktu tempuh. Sisakan jeda terutama bila Anda harus mengejar penerbangan, kereta, atau bus antarkota.</p></div>
      </div>
    </section>

    <section id="fasilitas" class="bg-[#0b2820] py-24 text-white md:py-32">
      <div class="section-shell">
        <div class="grid gap-12 lg:grid-cols-[.8fr_1.2fr]"><div><p class="eyebrow text-[#bde1dc]">Fasilitas & kebutuhan praktis</p><h2 class="display mt-5 text-5xl leading-[.95] md:text-7xl">Apa yang perlu dikonfirmasi.</h2></div><p class="self-end max-w-xl text-base leading-8 text-white/62">Ketersediaan fasilitas dan layanan saat ini belum diverifikasi. Gunakan daftar berikut sebagai pertanyaan untuk petugas atau operator, bukan jaminan bahwa setiap layanan tersedia di lokasi.</p></div>
        <div class="mt-12 grid gap-px overflow-hidden rounded-[2rem] bg-white/10 sm:grid-cols-2 lg:grid-cols-4">
          {[["Toilet / WC", "Tanyakan lokasi, kondisi dan jam toilet kepada petugas sebelum mengandalkannya."], ["Parkir", "Konfirmasikan area, tarif dan aturan parkir yang berlaku pada hari kunjungan."], ["Makan & minum", "Periksa lokasi dan jam tempat makan bila diperlukan; siapkan kebutuhan minum pribadi."], ["Tempat ibadah", "Tanyakan lokasi dan akses yang tersedia; fasilitas harian belum diverifikasi di sini."], ["Informasi", "Cari pengumuman dan petugas untuk status area serta jalur yang boleh dikunjungi."], ["Kebutuhan khusus", "Jika memerlukan obat atau bantuan tertentu, rencanakan melalui penyedia yang telah dikonfirmasi sebelum perjalanan."], ["Sinyal seluler", "Jangan bergantung pada sinyal di setiap area; siapkan informasi perjalanan secara luring."], ["Penginapan", "Jika menginap, periksa langsung lokasi, akses, jam dan ketentuan penyedia."], ["Belanja harian", "Siapkan perlengkapan sebelum perjalanan atau konfirmasikan toko yang benar-benar buka di rute Anda."], ["Bahan bakar", "Periksa lokasi dan jam operator bahan bakar sebelum perjalanan."], ["Pengisian listrik", "Lokasi dan ketersediaan pengisian kendaraan di destinasi belum diverifikasi; rencanakan titik yang dikonfirmasi operator."], ["Sampah & kebersihan", "Bawa kembali sampah dan ikuti aturan kebersihan setempat."]] .map(([title,text]) => <article class="bg-[#123b30] p-6"><h3 class="font-extrabold text-[#f2f5ee]">{title}</h3><p class="mt-3 text-sm leading-7 text-white/58">{text}</p></article>)}
