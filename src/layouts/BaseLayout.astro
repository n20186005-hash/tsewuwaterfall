---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import { SITE_NAME } from '../data/site';

interface Props {
  title: string;
  description: string;
  image?: string;
  schema?: unknown | unknown[];
  bodyClass?: string;
  noindex?: boolean;
}
const { title, description, image = '/images/tumpak-sewu-aerial.webp', schema, bodyClass = '', noindex = false } = Astro.props;
const canonical = !noindex && Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const absoluteImage = Astro.site ? new URL(image, Astro.site).href : undefined;
const schemas = !noindex && schema ? (Array.isArray(schema) ? schema : [schema]) : [];
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b2820" />
    <meta name="robots" content={noindex ? "noindex,follow" : "index,follow,max-image-preview:large"} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/icons/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/icons/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {absoluteImage && <meta property="og:image" content={absoluteImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    {schemas.map((item) => <script is:inline type="application/ld+json" set:html={JSON.stringify(item)}></script>)}
    <script is:inline>
      (() => {
        const key = 'tumpakSewuCookieConsent';
        const vetoKey = key + '-denied';
        const id = 'G-HXM22WWPKP';
        if (window.setTumpakAnalytics) return;
        window.dataLayer = window.dataLayer || [];
        window.gtag = window.gtag || function(){ window.dataLayer.push(arguments); };
        let loaded = false;
        let currentAllow = null;
        window.readTumpakConsent = () => {
          let data = {};
          try { data = JSON.parse(localStorage.getItem(key) || '{}') || {}; } catch {}
          try { if (sessionStorage.getItem(vetoKey) === '1') data.analytics = false; } catch {}
          if (currentAllow !== null) data.analytics = currentAllow;
          return data;
        };
        window.setTumpakAnalytics = (allow) => {
          currentAllow = allow;
          window['ga-disable-' + id] = !allow;
          window.gtag('consent', 'update', { analytics_storage: allow ? 'granted' : 'denied', ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied' });
          let sessionSaved = false;
          try { if (allow) sessionStorage.removeItem(vetoKey); else sessionStorage.setItem(vetoKey, '1'); sessionSaved = true; } catch {}
          if (allow && !loaded) {
            loaded = true;
            window.gtag('js', new Date());
            window.gtag('config', id, { anonymize_ip: true });
            const s = document.createElement('script');
            s.async = true;
            s.src = 'https://www.googletagmanager.com/gtag/js?id=' + id;
            document.head.appendChild(s);
          }
          return sessionSaved;
        };
        window.gtag('consent', 'default', { analytics_storage: 'denied', ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied' });
        window.setTumpakAnalytics(window.readTumpakConsent().analytics === true);
      })();
    </script>
  </head>
  <body class={bodyClass}>
    <slot />
    <Footer />
  </body>
</html>
